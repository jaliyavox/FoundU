    {
      "name": "SEC-01 anonymous request to a protected endpoint is refused",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/lost-reports/my-reports"
      },
      "event": [
        {
          "listen": "test",
