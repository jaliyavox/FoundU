  },
  "item": [
    {
      "name": "SETUP login student A (amara)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"amara@foundu.test\", \"password\": \"{{demoPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('logged in', () => pm.response.to.have.status(200)); pm.environment.set('studentA', pm.response.json().accessToken); pm.environment.set('refreshA', pm.response.json().refreshToken);"
