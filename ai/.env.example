# The deterministic fake remains the default and makes no network calls in tests.
LLM_PROVIDER=fake
LLM_MODEL=fake-structured-v1
LLM_TIMEOUT_SECONDS=5

# Required for protected service-to-service AI routes. Generate a strong random value locally;
# never commit a real key.
AI_SERVICE_KEY=replace-with-strong-random-secret

# For local Ollama use, select LLM_PROVIDER=ollama and set canonical LLM_MODEL to an installed
# local model. OLLAMA_MODEL is a backward-compatible fallback only when LLM_MODEL is absent.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
