# Phase 1 shared LLM foundation defaults to the deterministic fake provider and makes no
# network calls. These values are intentionally non-secret.
LLM_PROVIDER=fake
LLM_MODEL=fake-structured-v1
LLM_TIMEOUT_SECONDS=5

# Reserved for a future approved Ollama adapter. They are not read in Phase 1.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
